# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env.local` (gitignored) and adjust. All vars are build-time (Vite),
# so restart `pnpm dev` after changing them.
# ─────────────────────────────────────────────────────────────────────────────

# Transaction data source: "mock" | "owlpay"
#   mock   → synthetic in-browser data; no backend or auth needed (best first run)
#   owlpay → polls the real Bank Module /api/v1/quotes every 10s AND gates the UI
#            behind Harbor SSO (requires the three owlpay vars below)
VITE_TRANSACTION_SOURCE=mock

# ── Required only when VITE_TRANSACTION_SOURCE=owlpay ─────────────────────────
# Base URL of the Bank Module API. The source polls `${endpoint}/api/v1/quotes`.
# VITE_BANK_MODULE_API_ENDPOINT=https://api-bank-module.owlpay.com

# Harbor SSO base URL + the same-domain auth cookie name. When the cookie is
# absent, the app redirects to `${VITE_API_HARBOR_URL}/api/v1/auth/internal/login`.
# VITE_API_HARBOR_URL=https://harbor.owlpay.com
# VITE_AUTH_COOKIE_NAME=owlpay_token

# ── Optional (dev only) ──────────────────────────────────────────────────────
# Frontend-only dynamics on top of a STATIC backend snapshot: after the first
# real poll, evolve the buffer in-memory (trickle inserts / status changes /
# surge) so the polling UX is visible against mock data. "true" to enable.
# Only has an effect when VITE_TRANSACTION_SOURCE=owlpay.
VITE_OWLPAY_SIMULATE=false
